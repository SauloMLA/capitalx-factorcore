// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClientRecord {
  id        String   @id
  rfc       String   @unique
  name      String
  email     String
  status    String   // "PENDING" | "APPROVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations OperationRecord[]
  users      UserRecord[]

  @@map("clients")
}

model OperationRecord {
  id             String   @id
  clientId       String
  totalAmount    Float
  advancedAmount Float
  commission     Float
  depositAmount  Float
  createdAt      DateTime @default(now())

  client   ClientRecord    @relation(fields: [clientId], references: [id])
  invoices InvoiceRecord[]

  @@map("operations")
}

model InvoiceRecord {
  id          String   @id
  operationId String
  folio       String
  debtorRfc   String
  debtorName  String
  amount      Float
  issueDate   DateTime
  dueDate     DateTime
  createdAt   DateTime @default(now())

  operation OperationRecord @relation(fields: [operationId], references: [id])

  @@map("invoices")
}

model UserRecord {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("OPERATOR") // "ADMINISTRATOR" | "OPERATOR"
  isActive     Boolean  @default(true)
  clientId     String?  // Null para Administradores de Mesa de Control
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client        ClientRecord?       @relation(fields: [clientId], references: [id])
  refreshTokens RefreshTokenRecord[]

  @@index([email])
  @@index([clientId])
  @@map("users")
}

model RefreshTokenRecord {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user UserRecord @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
