// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClientRecord {
  id        String   @id
  rfc       String   @unique
  name      String
  email     String
  status    String   // "PENDING" | "APPROVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations OperationRecord[]
  users      UserRecord[]

  @@map("clients")
}

model OperationRecord {
  id             String   @id
  clientId       String
  totalAmount    Decimal  @db.Decimal(18, 2)
  advancedAmount Decimal  @db.Decimal(18, 2)
  commission     Decimal  @db.Decimal(18, 2)
  depositAmount  Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  client   ClientRecord    @relation(fields: [clientId], references: [id])
  invoices InvoiceRecord[]

  @@map("operations")
}

model InvoiceRecord {
  id          String   @id
  operationId String
  folio       String
  debtorRfc   String
  debtorName  String
  amount      Decimal  @db.Decimal(18, 2)
  issueDate   DateTime
  dueDate     DateTime
  createdAt   DateTime @default(now())

  operation OperationRecord @relation(fields: [operationId], references: [id])

  @@map("invoices")
}

model UserRecord {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("OPERATOR") // "ADMINISTRATOR" | "OPERATOR"
  isActive     Boolean  @default(true)
  clientId     String?  // Null para Administradores de Mesa de Control
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client        ClientRecord?       @relation(fields: [clientId], references: [id])
  refreshTokens RefreshTokenRecord[]

  @@index([email])
  @@index([clientId])
  @@map("users")
}

model RefreshTokenRecord {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user UserRecord @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLogRecord {
  id          String   @id
  entity      String
  entityId    String
  action      String
  performedBy String
  oldValue    String?  // JSON string
  newValue    String?  // JSON string
  ip          String?
  userAgent   String?
  timestamp   DateTime @default(now())

  @@index([entity, entityId])
  @@index([performedBy])
  @@map("audit_logs")
}

model NotificationRecord {
  id        String   @id
  userId    String?  // Null si es notificación global para la mesa de control
  title     String
  message   String
  type      String   @default("INFO") // "INFO" | "SUCCESS" | "WARNING" | "DANGER"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
